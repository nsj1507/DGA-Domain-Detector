{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "DGA Domain Detector visual language. The detector uses a warm paper canvas, deep teal instrument surfaces, acid-lime signal accents, and compact readable technical readouts.",
  "color": {
    "$type": "color",
    "light": {
      "background": { "$value": "#f5f3eb", "$description": "Warm paper-like application canvas." },
      "foreground": { "$value": "#1e2f34", "$description": "Deep teal ink for primary text." },
      "border": { "$value": "#d8d4c6" },
      "card": { "$value": "#fbfaf6" },
      "cardForeground": { "$value": "#1e2f34" },
      "popover": { "$value": "#fbfaf6" },
      "popoverForeground": { "$value": "#1e2f34" },
      "primary": { "$value": "#1e2f34", "$description": "Deep teal instrument controls and high-emphasis actions." },
      "primaryForeground": { "$value": "#fbfaf6" },
      "secondary": { "$value": "#e9e6da" },
      "secondaryForeground": { "$value": "#1e2f34" },
      "muted": { "$value": "#ebe8de" },
      "mutedForeground": { "$value": "#687276" },
      "accent": { "$value": "#b8d95c", "$description": "Acid-lime signal accent for active states and positive emphasis." },
      "accentForeground": { "$value": "#1e2f34" },
      "destructive": { "$value": "#c75b50", "$description": "Muted red for malicious verdicts and errors." },
      "destructiveForeground": { "$value": "#fbfaf6" },
      "input": { "$value": "#c9c5b7" },
      "ring": { "$value": "#8da83b" },
      "chart1": { "$value": "#8da83b" },
      "chart2": { "$value": "#314d57" },
      "chart3": { "$value": "#c75b50" },
      "chart4": { "$value": "#c28b2a" },
      "chart5": { "$value": "#4d827b" },
      "sidebar": { "$value": "#1e2f34" },
      "sidebarForeground": { "$value": "#fbfaf6" },
      "sidebarBorder": { "$value": "#36515a" },
      "sidebarPrimary": { "$value": "#b8d95c" },
      "sidebarPrimaryForeground": { "$value": "#1e2f34" },
      "sidebarAccent": { "$value": "#314d57" },
      "sidebarAccentForeground": { "$value": "#fbfaf6" },
      "sidebarRing": { "$value": "#b8d95c" }
    },
    "dark": {
      "background": { "$value": "#1b292d" },
      "foreground": { "$value": "#f4f1e8" },
      "border": { "$value": "#36515a" },
      "card": { "$value": "#24373d" },
      "cardForeground": { "$value": "#f4f1e8" },
      "popover": { "$value": "#24373d" },
      "popoverForeground": { "$value": "#f4f1e8" },
      "primary": { "$value": "#b8d95c" },
      "primaryForeground": { "$value": "#1e2f34" },
      "secondary": { "$value": "#314d57" },
      "secondaryForeground": { "$value": "#f4f1e8" },
      "muted": { "$value": "#29434a" },
      "mutedForeground": { "$value": "#a8b8b5" },
      "accent": { "$value": "#b8d95c" },
      "accentForeground": { "$value": "#1e2f34" },
      "destructive": { "$value": "#db766d" },
      "destructiveForeground": { "$value": "#1e2f34" },
      "input": { "$value": "#49646b" },
      "ring": { "$value": "#b8d95c" },
      "chart1": { "$value": "#b8d95c" },
      "chart2": { "$value": "#6aafa6" },
      "chart3": { "$value": "#db766d" },
      "chart4": { "$value": "#e2a84b" },
      "chart5": { "$value": "#91aeba" },
      "sidebar": { "$value": "#152226" },
      "sidebarForeground": { "$value": "#f4f1e8" },
      "sidebarBorder": { "$value": "#29434a" },
      "sidebarPrimary": { "$value": "#b8d95c" },
      "sidebarPrimaryForeground": { "$value": "#1e2f34" },
      "sidebarAccent": { "$value": "#29434a" },
      "sidebarAccentForeground": { "$value": "#f4f1e8" },
      "sidebarRing": { "$value": "#b8d95c" }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "sans": {
        "$value": ["Manrope", "sans-serif"],
        "$description": "Default UI and body typeface from the detector application."
      },
      "serif": { "$value": ["Georgia", "serif"] },
      "mono": {
        "$value": ["DM Mono", "monospace"],
        "$description": "Technical labels, domains, metrics, and system metadata."
      }
    }
  },
  "radius": {
    "$type": "dimension",
    "base": {
      "$value": "0.75rem",
      "$description": "Soft 12px base radius used across cards, inputs, badges, and controls."
    }
  },
  "spacing": {
    "$type": "dimension",
    "base": {
      "$value": "0.25rem",
      "$description": "Four-pixel rhythm used for compact analyst-workspace spacing."
    }
  }
}